{
  "name": "@geolonia/maps-core",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/npm/index.cjs",
  "module": "dist/npm/index.js",
  "types": "dist/npm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/npm/index.d.ts",
      "import": "./dist/npm/index.js",
      "require": "./dist/npm/index.cjs"
    },
    "./css": "./src/assets/style.css"
  },
  "files": [
    "dist/npm",
    "src/assets/style.css"
  ],
  "dependencies": {
    "@geolonia/mbgl-gesture-handling": "^1.0.15",
    "@turf/bbox": "^7.3.4",
    "@turf/center": "^6.0.1",
    "pmtiles": "^4.4.0",
    "sanitize-html": "^2.8.0",
    "tinycolor2": "^1.4.1"
  },
  "peerDependencies": {
    "maplibre-gl": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.58.2",
    "@types/sanitize-html": "^2.16.1",
    "@types/tinycolor2": "^1.4.6",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "maplibre-gl": "5.7.0",
    "tsup": "^8",
    "typescript": "^5.8",
    "vite": "^7.3.2",
    "vitest": "^4.1.2"
  },
  "scripts": {
    "build": "tsup",
    "build:umd": "vite build --config vite.umd.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "vite --config vite.config.ts",
    "e2e": "playwright test",
    "lint": "biome check src/ test/ e2e/ example/",
    "lint:fix": "biome check --write src/ test/ e2e/ example/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/geolonia/maps-core"
  }
}
